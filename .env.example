# FlowForge environment template. Copy to `.env` (git-ignored) and fill in.
# Every variable is documented in docs/ENVIRONMENT_VARIABLES.md.

# --- Core URLs --------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_HOST=127.0.0.1
API_PORT=4000

# --- PostgreSQL (source of truth) -------------------------------------------
# Local docker compose default shown. For a remote database add sslmode=verify-full
# (sslmode=require encrypts without verifying the certificate). Check with: flowforge-admin verify
DATABASE_URL=postgres://flowforge:flowforge_dev_only@127.0.0.1:54329/flowforge
DATABASE_POOL_MAX=10
# Server-side timeouts, sent as startup parameters. Behind a transaction-mode pooler set both
# to 0 and set them on the database role instead (docs/OPERATIONS.md#connection-poolers).
DATABASE_STATEMENT_TIMEOUT_MS=5000
DATABASE_IDLE_IN_TRANSACTION_TIMEOUT_MS=15000
# Client-side deadlines (hold even when the server or network is frozen).
DATABASE_ACQUIRE_TIMEOUT_MS=2000
DATABASE_QUERY_TIMEOUT_MS=8000
DATABASE_TRANSACTION_TIMEOUT_MS=10000

# --- Redis (optional: worker wake-ups + live dashboard events) --------------
# Local docker compose default shown. For Upstash use the rediss:// URL.
REDIS_URL=redis://127.0.0.1:63799/0
REDIS_COMMAND_TIMEOUT_MS=1000
REDIS_HEALTH_INTERVAL_MS=1000

# --- Sessions ---------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=<generate-a-random-48-byte-secret>
SESSION_TTL_HOURS=336

# --- OAuth (optional; leave empty to disable a provider) --------------------
# Placeholders for your real values live in .env.credentials (git-ignored).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Security / limits ------------------------------------------------------
ALLOWED_ORIGINS=
MAX_PAYLOAD_BYTES=1048576
DEFINITION_MAX_BYTES=262144
# Whose X-Forwarded-For to believe: the web app's server (apps/web/server.mjs) sets it from
# the real connection. 127.0.0.1 when the web app runs on this host; otherwise its addresses
# or CIDR. false believes no one (every browser then shares the web server's address).
TRUST_PROXY=127.0.0.1
RATE_LIMIT_IP_PER_MINUTE=6000
RATE_LIMIT_KEY_PER_MINUTE=1200
RATE_LIMIT_TENANT_PER_MINUTE=6000
AUTH_FAILURE_LIMIT=30
AUTH_FAILURE_WINDOW_MS=60000

# --- Engine tuning ----------------------------------------------------------
LEASE_DURATION_MS=30000
WORKER_HEARTBEAT_INTERVAL_MS=10000
WORKER_OFFLINE_AFTER_MS=60000
MAINTENANCE_INTERVAL_MS=1000
RUN_MAINTENANCE=true
OUTBOX_RELAY_INTERVAL_MS=100
PREDICTIVE_SCHEDULING=true

# --- Readiness --------------------------------------------------------------
READY_TIMEOUT_MS=2000
READY_REQUIRES_REDIS=false

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=info

# --- Engine clock (ADR-015) -------------------------------------------------
CLOCK_SOURCE=database
CLOCK_SYNC_INTERVAL_MS=15000

# --- Data retention (ADR-016; days, 0 keeps forever) ------------------------
RETENTION_RUNS_DAYS=30
RETENTION_WORKER_EVENTS_DAYS=30
RETENTION_SCHEDULING_DECISIONS_DAYS=14
RETENTION_OFFLINE_WORKERS_DAYS=7
RETENTION_EXPIRED_SESSIONS_DAYS=1
RETENTION_OUTBOX_HOURS=24
RETENTION_INTERVAL_MS=600000
RETENTION_BATCH_SIZE=500
RETENTION_MAX_BATCHES=20

# --- Metrics and tracing (ADR-017) ------------------------------------------
# Prometheus listener, separate from the API port. Bind to the interface your scraper reaches; never public.
METRICS_HOST=127.0.0.1
METRICS_PORT=9464
METRICS_STATE_INTERVAL_MS=15000
# OTLP/HTTP trace export (docker compose --profile observability: http://127.0.0.1:54318).
TRACING_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=flowforge-api
TRACING_SAMPLE_RATIO=1

# --- Worker processes (read by the SDK worker, not the API) -----------------
FLOWFORGE_API_URL=http://localhost:4000
FLOWFORGE_API_KEY=<worker-scoped-api-key-from-flowforge-admin>
