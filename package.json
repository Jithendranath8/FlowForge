{
  "name": "flowforge",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b packages/core packages/db packages/sdk apps/api examples/quickstart",
    "typecheck": "tsc -b packages/core packages/db packages/sdk apps/api examples/quickstart && tsc -p tsconfig.test.json && tsc -p apps/web/tsconfig.test.json",
    "lint": "eslint .",
    "test": "npm run build && vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "npm run build && vitest run --project integration",
    "test:coverage": "npm run build && vitest run --coverage",
    "verify:hosted": "node scripts/verify-hosted.mjs",
    "dev:api": "node scripts/dev-api.mjs",
    "check:quickstart": "node scripts/check-quickstart.mjs",
    "admin": "node --env-file-if-exists=.env apps/api/dist/admin.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "^17.13.0",
    "jsdom": "30.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
