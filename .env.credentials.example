# Credentials only you can provide. Copy to `.env.credentials` (git-ignored, never
# committed) and replace every REPLACE_ME. Lines still containing REPLACE_ME are skipped.
# Then run:  npm run build && npm run verify:hosted
# See docs/OPERATIONS.md#verifying-a-deployment.

# --- Hosted PostgreSQL (e.g. Neon, Supabase) ----------------------------------
# The provider's POOLED connection string (what the API should use in production).
# Keep sslmode=verify-full: sslmode=require does not verify the server certificate.
HOSTED_DATABASE_URL=postgres://REPLACE_ME_USER:REPLACE_ME_PASSWORD@REPLACE_ME_POOLED_HOST/REPLACE_ME_DB?sslmode=verify-full
# Optional: the DIRECT (non-pooled) connection string, for comparison.
HOSTED_DATABASE_URL_DIRECT=postgres://REPLACE_ME_USER:REPLACE_ME_PASSWORD@REPLACE_ME_DIRECT_HOST/REPLACE_ME_DB?sslmode=verify-full
# If the pooler rejects or drops startup parameters, `verify` says so; then set both to 0
# and run on the database:  ALTER ROLE <user> SET statement_timeout = '5s';
#                           ALTER ROLE <user> SET idle_in_transaction_session_timeout = '15s';
HOSTED_DATABASE_STATEMENT_TIMEOUT_MS=5000
HOSTED_DATABASE_IDLE_IN_TRANSACTION_TIMEOUT_MS=15000

# --- Hosted Redis (e.g. Upstash) ------------------------------------------------
# Must be rediss:// (TLS).
HOSTED_REDIS_URL=rediss://default:REPLACE_ME_PASSWORD@REPLACE_ME_HOST:6379

# --- OAuth (Phase 5: dashboard sign-in) -----------------------------------------
# The web app forwards /api/* to the API, so callbacks are on the web app's address.
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID > Web application
#   Authorized JavaScript origin: http://localhost:3000
#   Authorized redirect URI:      http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=REPLACE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=REPLACE_ME
# GitHub > Settings > Developer settings > OAuth Apps > New OAuth App
#   Homepage URL:               http://localhost:3000
#   Authorization callback URL: http://localhost:3000/api/auth/github/callback
#   (one callback per GitHub app: production needs a second app for your domain)
GITHUB_CLIENT_ID=REPLACE_ME
GITHUB_CLIENT_SECRET=REPLACE_ME
# Who may sign in: comma-separated emails and/or @domains, e.g. you@example.com,@yourcompany.com
AUTH_ALLOWED_EMAILS=REPLACE_ME@example.com
